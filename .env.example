# =====================================================================
# Lockverity - example environment configuration.
# Copy to `.env` for local development. Never commit real secrets.
# =====================================================================

# Runtime environment: "development" | "test" | "production"
LOCKVERITY_ENV=development

# API
LOCKVERITY_API_PREFIX=/api/v1
LOCKVERITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. SQLite by default. For PostgreSQL use:
#   postgresql+psycopg://user:pass@host:5432/lockverity
LOCKVERITY_DATABASE_URL=sqlite:///./lockverity.sqlite

# Workspace root for uploaded archive storage and runtime artefacts.
# Must NOT be served by the API or the frontend.
LOCKVERITY_WORKSPACE_ROOT=./var/workspace

# --- Archive safety limits (defensive defaults) ---
LOCKVERITY_ARCHIVE_MAX_COMPRESSED_BYTES=104857600      # 100 MiB
LOCKVERITY_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824   #  1 GiB
LOCKVERITY_ARCHIVE_MAX_FILE_COUNT=100000
LOCKVERITY_ARCHIVE_MAX_FILE_BYTES=268435456            # 256 MiB per entry
LOCKVERITY_ARCHIVE_MAX_DEPTH=64
LOCKVERITY_ARCHIVE_SUSPICIOUS_RATIO=200               # uncompressed / compressed

# --- External provider safety ---
LOCKVERITY_PROVIDER_TIMEOUT_SECONDS=15
LOCKVERITY_PROVIDER_MAX_RESPONSE_BYTES=10485760       # 10 MiB
LOCKVERITY_PROVIDER_RETRY_LIMIT=2

# --- Pagination ---
LOCKVERITY_PAGINATION_DEFAULT_PAGE_SIZE=25
LOCKVERITY_PAGINATION_MAX_PAGE_SIZE=200

# --- Note on removed settings ---
# The configurable GitHub API origin override was
# removed in the v2.0.6 public-closure cycle. The
# bounded HTTP client's allowlist pins the canonical
# https://api.github.com host; the override was
# unused. If a future release needs an alternate API
# origin, the change must wire it through every URL
# builder AND extend the allowlist with the same SSRF
# and host-restriction validation applied to the
# canonical origin.
